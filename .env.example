# Analytics (opcional) — defina estes no Cloudflare Pages:
# Settings → Environment variables → Production.
# Sem eles, o site funciona normalmente, só sem métricas.

# Microsoft Clarity → https://clarity.microsoft.com → Settings → "Clarity tag" id
VITE_CLARITY_ID=

# Cloudflare Web Analytics → dash → Analytics & Logs → Web Analytics → token
VITE_CF_BEACON_TOKEN=
